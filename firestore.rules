rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contratos Vigentes da GAD (importados da planilha)
    match /contratosVigentes/{contratoId} {
      allow read, write: if true;
    }

    // Processos de contratos e etapas da GAD / COMPESA
    match /processos/{processoId} {
      allow read, write: if true;

      match /etapas/{etapaId} {
        allow read, write: if true;
      }

      match /logs/{logId} {
        allow read, write: if true;
      }
    }

    // Gestores Responsaveis
    match /gestores/{gestorId} {
      allow read, write: if true;
    }

    // Empresas Contratadas
    match /empresasContratadas/{empresaId} {
      allow read, write: if true;
    }

    // Gestao de usuarios e perfis
    match /usuarios/{userId} {
      allow read, write: if true;
    }

    // Auditoria geral
    match /auditoria_geral/{auditId} {
      allow read, write: if true;
    }

    // Regra fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
